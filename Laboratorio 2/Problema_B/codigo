.include "m328pdef.inc"

; r17 = posición
; r18 = señal
; r19 y r20 = temporales
; r21:r22 = OCR1A

.equ FRECUENCIA_INICIAL = 600
.equ FRECUENCIA_MIN = 20
.equ FRECUENCIA_MAX = 1000
.equ PASO_FRECUENCIA = 10

.org 0x0000
    rjmp INICIO

.org 0x0016
    rjmp TIMER1_COMPA

INICIO:
    ldi r16, 0xFE
    out DDRD, r16

    ldi r16, 0
    out PORTD, r16

    ldi r16, 0x03
    out DDRB, r16

    in r16, PORTB
    andi r16, 0xFC
    out PORTB, r16

    clr r17
    ldi r18, 15
    clr r1

    ldi r16, 0
    sts UCSR0A, r16

    ldi r16, 0
    sts UBRR0H, r16

    ldi r16, 103
    sts UBRR0L, r16

    ldi r16, (1<<RXEN0) | (1<<TXEN0)
    sts UCSR0B, r16

    ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
    sts UCSR0C, r16

    ldi r16, (1<<WGM12) | (1<<CS11) | (1<<CS10)
    sts TCCR1B, r16

    ldi r21, LOW(FRECUENCIA_INICIAL)
    ldi r22, HIGH(FRECUENCIA_INICIAL)

    sts OCR1AL, r21
    sts OCR1AH, r22

    ldi r16, (1<<OCIE1A)
    sts TIMSK1, r16

    sei

    rcall MOSTRAR_MENU
    rcall MOSTRAR_FRECUENCIA

BUCLE:
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp BUCLE

    lds r16, UDR0

    cpi r16, '1'
    breq SELECCION_15

    cpi r16, '2'
    breq SELECCION_9

    cpi r16, '+'
    breq FRECUENCIA_MAS

    cpi r16, '-'
    breq FRECUENCIA_MENOS

    rjmp BUCLE

FRECUENCIA_MAS:
    cpi r22, HIGH(FRECUENCIA_MIN)
    brne MAS_CAMBIAR

    cpi r21, LOW(FRECUENCIA_MIN)
    brlo MAS_CAMBIAR

    rjmp BUCLE

MAS_CAMBIAR:
    subi r21, LOW(PASO_FRECUENCIA)
    sbci r22, HIGH(PASO_FRECUENCIA)

    cpi r22, HIGH(FRECUENCIA_MIN)
    brlo MAS_LIMITE

    brne MAS_CARGAR

    cpi r21, LOW(FRECUENCIA_MIN)
    brsh MAS_CARGAR

MAS_LIMITE:
    ldi r21, LOW(FRECUENCIA_MIN)
    ldi r22, HIGH(FRECUENCIA_MIN)

MAS_CARGAR:
    sts OCR1AL, r21
    sts OCR1AH, r22

    rcall MOSTRAR_FRECUENCIA

    rjmp BUCLE

FRECUENCIA_MENOS:
    cpi r22, HIGH(FRECUENCIA_MAX)
    brlo MENOS_CAMBIAR

    cpi r21, LOW(FRECUENCIA_MAX)
    brlo MENOS_CAMBIAR

    rjmp BUCLE

MENOS_CAMBIAR:
    subi r21, LOW(-PASO_FRECUENCIA)
    sbci r22, HIGH(-PASO_FRECUENCIA)

    cpi r22, HIGH(FRECUENCIA_MAX)
    brlo MENOS_CARGAR

    brne MENOS_LIMITE

    cpi r21, LOW(FRECUENCIA_MAX)
    brlo MENOS_CARGAR

MENOS_LIMITE:
    ldi r21, LOW(FRECUENCIA_MAX)
    ldi r22, HIGH(FRECUENCIA_MAX)

MENOS_CARGAR:
    sts OCR1AL, r21
    sts OCR1AH, r22

    rcall MOSTRAR_FRECUENCIA

    rjmp BUCLE

