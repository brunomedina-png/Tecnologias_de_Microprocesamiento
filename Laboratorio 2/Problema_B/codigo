MOSTRAR_FRECUENCIA:
    mov r23, r21
    mov r24, r22

    inc r23
    brne DIVISOR_LISTO
    inc r24

DIVISOR_LISTO:
    ldi r25, 0x48
    ldi r26, 0xE8
    ldi r27, 0x01

    clr r30
    clr r31

DIVISION:
    cp r25, r23
    cpc r26, r24
    cpc r27, r1
    brlo FIN_DIVISION

    sub r25, r23
    sbc r26, r24
    sbci r27, 0

    inc r30
    brne DIVISION

    inc r31
    rjmp DIVISION

FIN_DIVISION:
    ldi r16, 'F'
    rcall ENVIAR
    ldi r16, 'r'
    rcall ENVIAR
    ldi r16, 'e'
    rcall ENVIAR
