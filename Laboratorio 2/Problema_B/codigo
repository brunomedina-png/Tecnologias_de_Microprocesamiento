    rcall ENVIAR
    ldi r16, ' '
    rcall ENVIAR

    mov r28, r30
    mov r29, r31

    clr r30

MILES:
    cpi r29, HIGH(1000)
    brlo CENTENAS

    subi r28, LOW(1000)
    sbci r29, HIGH(1000)
    inc r30
    rjmp MILES

CENTENAS:
    clr r31

CIENTOS:
    cpi r28, 100
    brlo DECENAS

    subi r28, 100
    inc r31
    rjmp CIENTOS

DECENAS:
    clr r29

DIECES:
    cpi r28, 10
    brlo UNIDADES

    subi r28, 10
    inc r29
    rjmp DIECES

UNIDADES:
    cpi r30, 0
    breq SIN_MILES

    mov r16, r30
    subi r16, -'0'
    rcall ENVIAR

SIN_MILES:
    cpi r30, 0
    brne MOSTRAR_CENTENAS

    cpi r31, 0
    breq SIN_CENTENAS

MOSTRAR_CENTENAS:
    mov r16, r31
    subi r16, -'0'
    rcall ENVIAR

SIN_CENTENAS:
    cpi r30, 0
    brne MOSTRAR_DECENAS

    cpi r31, 0
    brne MOSTRAR_DECENAS

    cpi r29, 0
    breq SIN_DECENAS

MOSTRAR_DECENAS:
    mov r16, r29
    subi r16, -'0'
    rcall ENVIAR

SIN_DECENAS:
    mov r16, r28
    subi r16, -'0'
    rcall ENVIAR

    ldi r16, ' '
    rcall ENVIAR

    ldi r16, 'H'
    rcall ENVIAR

    ldi r16, 'z'
    rcall ENVIAR

    ldi r16, 13
    rcall ENVIAR

    ldi r16, 10
    rcall ENVIAR

    ret

ENVIAR:
ESPERAR_TX:
    lds r19, UCSR0A
    sbrs r19, UDRE0
    rjmp ESPERAR_TX

    sts UDR0, r16
    ret

TIMER1_COMPA:
    push r16
    push r19
    push r20
    push r30
    push r31

    cpi r18, 15
    brne NO_LUT15

    ldi ZH, HIGH(LUT15*2)
    ldi ZL, LOW(LUT15*2)
    rjmp LEER_LUT

NO_LUT15:
    ldi ZH, HIGH(LUT9*2)
    ldi ZL, LOW(LUT9*2)

LEER_LUT:
    add ZL, r17

    brcc SIN_CARRY
    inc ZH

SIN_CARRY:
    lpm r16, Z

    mov r19, r16
    andi r19, 0xFC

    in r20, PORTD
    andi r20, 0x03
    or r20, r19
    out PORTD, r20

    andi r16, 0x03

    in r20, PORTB
    andi r20, 0xFC
    or r20, r16
    out PORTB, r20

    inc r17

    cpi r18, 9
    brne FIN_TIMER

    cpi r17, 32
    brlo FIN_TIMER

    clr r17

FIN_TIMER:
    pop r31
    pop r30
    pop r20
    pop r19
    pop r16

    reti

