.include "m328pdef.inc"

; r17 = posicion
; r18 = señal
; r19:r20 = temporales
; r21:r22 = OCR1A

.equ OCR_INICIAL = 600

.org 0x0000
    rjmp INICIO

.org 0x0016
    rjmp TIMER1_COMPA

INICIO:
    ldi r16, 0xFE
    out DDRD, r16

    ldi r16, 0
    out PORTD, r16

    ldi r16, 0x03
    out DDRB, r16

    in r16, PORTB
    andi r16, 0xFC
    out PORTB, r16

    clr r17
    ldi r18, 15
    clr r1

    ldi r16, 0
    sts UCSR0A, r16

    ldi r16, 0
    sts UBRR0H, r16

    ldi r16, 103
    sts UBRR0L, r16

    ldi r16, (1<<RXEN0) | (1<<TXEN0)
    sts UCSR0B, r16

    ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
    sts UCSR0C, r16

    ldi r16, (1<<WGM12) | (1<<CS11) | (1<<CS10)
    sts TCCR1B, r16

    ldi r21, LOW(OCR_INICIAL)
    ldi r22, HIGH(OCR_INICIAL)

    sts OCR1AL, r21
    sts OCR1AH, r22

    ldi r16, (1<<OCIE1A)
    sts TIMSK1, r16

    sei

    ldi r16, '1'
    rcall ENVIAR
    ldi r16, ' '
    rcall ENVIAR
    ldi r16, 'S'
    rcall ENVIAR
    ldi r16, 'e'
    rcall ENVIAR
    ldi r16, 'n'
    rcall ENVIAR
    ldi r16, 'a'
    rcall ENVIAR
    ldi r16, 'l'
    rcall ENVIAR
    ldi r16, ' '
    rcall ENVIAR
    ldi r16, '1'
    rcall ENVIAR
    ldi r16, '5'
    rcall ENVIAR
    ldi r16, 13
    rcall ENVIAR
    ldi r16, 10
    rcall ENVIAR

    ldi r16, '2'
    rcall ENVIAR
    ldi r16, ' '
    rcall ENVIAR
    ldi r16, 'S'
    rcall ENVIAR
    ldi r16, 'e'
    rcall ENVIAR
    ldi r16, 'n'
    rcall ENVIAR
    ldi r16, 'a'
    rcall ENVIAR
    ldi r16, 'l'
    rcall ENVIAR
    ldi r16, ' '
    rcall ENVIAR
    ldi r16, '9'
    rcall ENVIAR
    ldi r16, 13
    rcall ENVIAR
    ldi r16, 10
    rcall ENVIAR

BUCLE:
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp BUCLE

    lds r16, UDR0

    cpi r16, '1'
    breq SELECCION_15

    cpi r16, '2'
    breq SELECCION_9

    rjmp BUCLE

SELECCION_15:
    ldi r18, 15
    clr r17

    ldi r16, '1'
    rcall ENVIAR
    ldi r16, '5'
    rcall ENVIAR
    ldi r16, 13
    rcall ENVIAR
    ldi r16, 10
    rcall ENVIAR

    rjmp BUCLE

SELECCION_9:
    ldi r18, 9
    clr r17

    ldi r16, '9'
    rcall ENVIAR
    ldi r16, 13
    rcall ENVIAR
    ldi r16, 10
    rcall ENVIAR

    rjmp BUCLE

ENVIAR:
ESPERAR_TX:
    lds r19, UCSR0A
    sbrs r19, UDRE0
    rjmp ESPERAR_TX

    sts UDR0, r16
    ret

TIMER1_COMPA:
    push r16
    push r19
    push r20
    push r30
    push r31

    cpi r18, 15
    brne USAR_9

    ldi ZH, HIGH(LUT15*2)
    ldi ZL, LOW(LUT15*2)
    rjmp LEER

USAR_9:
    ldi ZH, HIGH(LUT9*2)
    ldi ZL, LOW(LUT9*2)

LEER:
    add ZL, r17

    brcc SIN_CARRY
    inc ZH

SIN_CARRY:
    lpm r16, Z

    mov r19, r16
    andi r19, 0xFC

    in r20, PORTD
    andi r20, 0x03
    or r20, r19
    out PORTD, r20

    andi r16, 0x03

    in r20, PORTB
    andi r20, 0xFC
    or r20, r16
    out PORTB, r20

    inc r17

    cpi r18, 9
    brne FIN_TIMER

    cpi r17, 32
    brlo FIN_TIMER

    clr r17

FIN_TIMER:
    pop r31
    pop r30
    pop r20
    pop r19
    pop r16

    reti

LUT9:
