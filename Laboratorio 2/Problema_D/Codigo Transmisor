.include "m328pdef.inc"

.org 0x0000
rjmp INICIO

INICIO:
; Stack
ldi r16, HIGH(RAMEND)
out SPH, r16
ldi r16, LOW(RAMEND)
out SPL, r16

; Entradas con pull-up
cbi DDRB, PB0
cbi DDRB, PB1
cbi DDRB, PB2

sbi PORTB, PB0
sbi PORTB, PB1
sbi PORTB, PB2

; USART 9600
ldi r16, 103
sts UBRR0L, r16
ldi r16, 0
sts UBRR0H, r16

ldi r16, (1<<TXEN0)
sts UCSR0B, r16

ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
sts UCSR0C, r16

MAIN:
in r17, PINB
andi r17, 0b00000111

ldi r16, 0b00000111
eor r17, r16

ESPERAR:
lds r16, UCSR0A
sbrs r16, UDRE0
rjmp ESPERAR

sts UDR0, r17

rjmp MAIN
