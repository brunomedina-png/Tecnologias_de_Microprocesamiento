.include "m328Pdef.inc"

.def MODE = r16
.def DATA_UART = r17
.def FILA = r18
.def POS = r19
.def CONT1 = r20
.def CONT2 = r21
.def MASK = r22
.def DATA = r23
.def SCROLL_L = r24
.def SCROLL_H = r25
.def TEMP = r26
.def TEMP2 = r27
.def VELOCIDAD_L = r28
.def VELOCIDAD_H = r29

.equ VELOCIDAD = 180
.equ VELOCIDAD_MIN = 10
.equ VELOCIDAD_MAX = 1000
.equ UBRR_VAL = 103

.org 0x0000
    rjmp INICIO

INICIO:
    ldi TEMP, HIGH(RAMEND)
    out SPH, TEMP
    ldi TEMP, LOW(RAMEND)
    out SPL, TEMP

    ldi TEMP, 0b11111110
    out DDRD, TEMP

    ldi TEMP, 0b00111111
    out DDRB, TEMP

    ldi TEMP, 0b00001111
    out DDRC, TEMP

    ldi TEMP, 0
    out PORTC, TEMP

    clr r1

    rcall UART_INICIO
    rcall APAGAR

    ldi MODE, 0
    ldi POS, 0

    ldi VELOCIDAD_L, low(VELOCIDAD)
    ldi VELOCIDAD_H, high(VELOCIDAD)

    mov SCROLL_L, VELOCIDAD_L
    mov SCROLL_H, VELOCIDAD_H

    rcall MOSTRAR_MENU

MAIN:
    rcall UART_REVISAR

    cpi MODE, 0
    breq MODO_TEXTO

    cpi MODE, 1
    breq MODO_SONRISA

    cpi MODE, 2
    breq MODO_GUINO

    cpi MODE, 3
    breq MODO_CORAZON

    cpi MODE, 4
    breq MODO_CARA3

    cpi MODE, 5
    breq MODO_ASTERISCO

    rjmp MODO_XD

MODO_TEXTO:
    ldi FILA, 0
    rcall MOSTRAR_FILA
    ldi FILA, 1
    rcall MOSTRAR_FILA
    ldi FILA, 2
    rcall MOSTRAR_FILA
    ldi FILA, 3
    rcall MOSTRAR_FILA
    ldi FILA, 4
    rcall MOSTRAR_FILA
    ldi FILA, 5
    rcall MOSTRAR_FILA
    ldi FILA, 6
    rcall MOSTRAR_FILA
    ldi FILA, 7
    rcall MOSTRAR_FILA

    subi SCROLL_L, 1
    sbci SCROLL_H, 0

    brne MAIN

    inc POS

    cpi POS, 208
    brlo TEXTO_CONTINUA

    ldi POS, 0

TEXTO_CONTINUA:
    mov SCROLL_L, VELOCIDAD_L
    mov SCROLL_H, VELOCIDAD_H

    rjmp MAIN

MODO_SONRISA:
    ldi ZL, low(SONRISA*2)
    ldi ZH, high(SONRISA*2)
    rcall ESCANEAR_FIGURA
    rjmp MAIN

MODO_GUINO:
    ldi ZL, low(GUINO*2)
    ldi ZH, high(GUINO*2)
    rcall ESCANEAR_FIGURA
    rjmp MAIN

MODO_CORAZON:
    ldi ZL, low(CORAZON*2)
    ldi ZH, high(CORAZON*2)
    rcall ESCANEAR_FIGURA
    rjmp MAIN

MODO_CARA3:
    ldi ZL, low(CARA3*2)
    ldi ZH, high(CARA3*2)
    rcall ESCANEAR_FIGURA
    rjmp MAIN

MODO_ASTERISCO:
    ldi ZL, low(ASTERISCO*2)
    ldi ZH, high(ASTERISCO*2)
    rcall ESCANEAR_FIGURA
    rjmp MAIN

MODO_XD:
    ldi ZL, low(XD*2)
    ldi ZH, high(XD*2)
    rcall ESCANEAR_FIGURA
    rjmp MAIN

MOSTRAR_FILA:
    rcall APAGAR_FILAS

    ldi ZL, low(TABLA*2)
    ldi ZH, high(TABLA*2)

    add ZL, POS
    adc ZH, r1

    clr DATA

    lpm TEMP2, Z
    ldi MASK, 1
    sbrc TEMP2, 0
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 2
    sbrc TEMP2, 1
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 4
    sbrc TEMP2, 2
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 8
    sbrc TEMP2, 3
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 16
    sbrc TEMP2, 4
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 32
    sbrc TEMP2, 5
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 64
    sbrc TEMP2, 6
    or DATA, MASK
    adiw ZL, 1

    lpm TEMP2, Z
    ldi MASK, 128
    sbrc TEMP2, 7
    or DATA, MASK

    rcall CARGAR
    ret

CARGAR:
    clr TEMP
    out PORTD, TEMP

    in TEMP, PORTB
    andi TEMP, 0b11111100
    out PORTB, TEMP

    sbrc DATA, 0
    sbi PORTD, 2
    sbrc DATA, 1
    sbi PORTD, 3
    sbrc DATA, 2
    sbi PORTD, 4
    sbrc DATA, 3
    sbi PORTD, 5
    sbrc DATA, 4
    sbi PORTD, 6
    sbrc DATA, 5
    sbi PORTD, 7
    sbrc DATA, 6
    sbi PORTB, 0
    sbrc DATA, 7
    sbi PORTB, 1

    cpi FILA, 0
    breq F0

    cpi FILA, 1
    breq F1

    cpi FILA, 2
    breq F2

    cpi FILA, 3
    breq F3

    cpi FILA, 4
    breq F4

    cpi FILA, 5
    breq F5

    cpi FILA, 6
    breq F6

    cbi PORTC, 3
    rjmp ESPERA

F0:
    cbi PORTB, 2
    rjmp ESPERA

F1:
    cbi PORTB, 3
    rjmp ESPERA

F2:
    cbi PORTB, 4
    rjmp ESPERA

F3:
    cbi PORTB, 5
    rjmp ESPERA

F4:
    cbi PORTC, 0
    rjmp ESPERA

F5:
    cbi PORTC, 1
    rjmp ESPERA

F6:
    cbi PORTC, 2

ESPERA:
    ldi CONT1, 2

RETARDO1:
    ldi CONT2, 80

RETARDO2:
    dec CONT2
    brne RETARDO2

    dec CONT1
    brne RETARDO1

    ret

APAGAR_FILAS:
    sbi PORTB, 2
    sbi PORTB, 3
    sbi PORTB, 4
    sbi PORTB, 5

    sbi PORTC, 0
    sbi PORTC, 1
    sbi PORTC, 2
    sbi PORTC, 3

    ret

APAGAR:
    rcall APAGAR_FILAS

    clr TEMP
    out PORTD, TEMP

    in TEMP, PORTB
    andi TEMP, 0b11111100
    out PORTB, TEMP

    ret

ESCANEAR_FIGURA:
    ldi FILA, 0

FIGURA_FILA:
    rcall APAGAR_FILAS

    lpm DATA, Z+

    mov TEMP2, DATA
    andi TEMP2, 0b00111111

    lsl TEMP2
    lsl TEMP2

    in TEMP, PORTD
    andi TEMP, 0b00000011

    or TEMP, TEMP2
    out PORTD, TEMP

    mov TEMP2, DATA

    lsr TEMP2
    lsr TEMP2
    lsr TEMP2
    lsr TEMP2
    lsr TEMP2
    lsr TEMP2

    andi TEMP2, 0b00000011

    in TEMP, PORTB
    andi TEMP, 0b11111100

    or TEMP, TEMP2
    out PORTB, TEMP

    cpi FILA, 0
    breq FIG_F1

    cpi FILA, 1
    breq FIG_F2

    cpi FILA, 2
    breq FIG_F3

    cpi FILA, 3
    breq FIG_F4

    cpi FILA, 4
    breq FIG_F5

    cpi FILA, 5
    breq FIG_F6

    cpi FILA, 6
    breq FIG_F7

    rjmp FIG_F8

FIG_F1:
    cbi PORTB, 2
    rjmp ESPERA_FIGURA

FIG_F2:
    cbi PORTB, 3
    rjmp ESPERA_FIGURA

FIG_F3:
    cbi PORTB, 4
    rjmp ESPERA_FIGURA

FIG_F4:
    cbi PORTB, 5
    rjmp ESPERA_FIGURA

FIG_F5:
    cbi PORTC, 0
    rjmp ESPERA_FIGURA

FIG_F6:
    cbi PORTC, 1
    rjmp ESPERA_FIGURA

FIG_F7:
    cbi PORTC, 2
    rjmp ESPERA_FIGURA

FIG_F8:
    cbi PORTC, 3

ESPERA_FIGURA:
    ldi TEMP, 20

RF1:
    ldi TEMP2, 250

RF2:
    dec TEMP2
    brne RF2

    dec TEMP
    brne RF1

    rcall UART_REVISAR

    inc FILA

    cpi FILA, 8
    brne FIGURA_FILA

    ret

UART_INICIO:
    ldi TEMP, UBRR_VAL
    sts UBRR0L, TEMP

    ldi TEMP, 0
    sts UBRR0H, TEMP

    ldi TEMP, (1<<RXEN0)|(1<<TXEN0)
    sts UCSR0B, TEMP

    ldi TEMP, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, TEMP

    ret

UART_REVISAR:
    lds TEMP, UCSR0A

    sbrs TEMP, RXC0
    ret

    lds DATA_UART, UDR0

    cpi DATA_UART, '+'
    breq MAS_RAPIDO

    cpi DATA_UART, '-'
    breq MAS_LENTO

    cpi DATA_UART, '1'
    breq UART_TEXTO

    cpi DATA_UART, '2'
    breq UART_SONRISA

    cpi DATA_UART, '3'
    breq UART_GUINO

    cpi DATA_UART, '4'
    breq UART_CORAZON

    cpi DATA_UART, '5'
    breq UART_CARA3

    cpi DATA_UART, '6'
    breq UART_ASTERISCO

    cpi DATA_UART, '7'
    breq UART_XD

    ret

MAS_RAPIDO:
    cpi VELOCIDAD_L, VELOCIDAD_MIN
    breq RET

    subi VELOCIDAD_L, 10
    sbci VELOCIDAD_H, 0

    cpi VELOCIDAD_L, VELOCIDAD_MIN
    brsh RET

    ldi VELOCIDAD_L, low(VELOCIDAD_MIN)
    ldi VELOCIDAD_H, high(VELOCIDAD_MIN)

RET:
    mov SCROLL_L, VELOCIDAD_L
    mov SCROLL_H, VELOCIDAD_H
    ret

MAS_LENTO:
    cpi VELOCIDAD_H, high(VELOCIDAD_MAX)
    brne SUBIR_VELOCIDAD

    cpi VELOCIDAD_L, low(VELOCIDAD_MAX)
    breq RET2

SUBIR_VELOCIDAD:
    subi VELOCIDAD_L, low(-10)
    sbci VELOCIDAD_H, high(-10)

    cpi VELOCIDAD_H, high(VELOCIDAD_MAX)
    brlo RET2

    ldi VELOCIDAD_L, low(VELOCIDAD_MAX)
    ldi VELOCIDAD_H, high(VELOCIDAD_MAX)

RET2:
    mov SCROLL_L, VELOCIDAD_L
    mov SCROLL_H, VELOCIDAD_H
    ret

UART_TEXTO:
    ldi MODE, 0
    ldi POS, 0
    mov SCROLL_L, VELOCIDAD_L
    mov SCROLL_H, VELOCIDAD_H
    ret

UART_SONRISA:
    ldi MODE, 1
    ret

UART_GUINO:
    ldi MODE, 2
    ret

UART_CORAZON:
    ldi MODE, 3
    ret

UART_CARA3:
    ldi MODE, 4
    ret

UART_ASTERISCO:
    ldi MODE, 5
    ret

UART_XD:
    ldi MODE, 6
    ret

MOSTRAR_MENU:
    ldi ZL, low(MENU*2)
    ldi ZH, high(MENU*2)

MENU_LOOP:
    lpm TEMP, Z+
    tst TEMP
    breq MENU_FIN

ESPERA_TX:
    lds TEMP2, UCSR0A
    sbrs TEMP2, UDRE0
    rjmp ESPERA_TX

    sts UDR0, TEMP
    rjmp MENU_LOOP

MENU_FIN:
    ret

MENU:
    .db "1 - JEBUS Y MARCELO LO MEJOR",13,10
    .db "2 - SONRISA",13,10
    .db "3 - GUINO",13,10
    .db "4 - CORAZON",13,10
    .db "5 - CARA :3",13,10
    .db "6 - ASTERISCO",13,10
    .db "7 - XD",13,10
    .db "+ rapido  - lento",13,10,0

TABLA:
    .db 0,0,0,0,0,0,0,0
    .db 0,0,32,64,64,64,63,0
    .db 0,0,127,73,73,73,65,0
    .db 0,0,127,73,73,73,54,0
    .db 0,0,63,64,64,64,63,0
    .db 0,0,70,73,73,73,57,0
    .db 0,0,0,0,0,0,0,0
    .db 0,0,3,4,120,4,3,0
    .db 0,0,0,0,0,0,0,0
    .db 0,0,127,2,12,2,127,0
    .db 0,0,126,9,9,9,126,0
    .db 0,0,127,9,25,41,70,0
    .db 0,0,62,65,65,65,34,0
    .db 0,0,127,73,73,73,65,0
    .db 0,0,127,64,64,64,64,0
    .db 0,0,62,65,65,65,62,0
    .db 0,0,0,0,0,0,0,0
    .db 0,0,127,64,64,64,64,0
    .db 0,0,62,65,65,65,62,0
    .db 0,0,0,0,0,0,0,0
    .db 0,0,127,2,12,2,127,0
    .db 0,0,127,73,73,73,65,0
    .db 0,0,32,64,64,64,63,0
    .db 0,0,62,65,65,65,62,0
    .db 0,0,127,9,25,41,70,0
    .db 0,0,0,0,0,0,0,0

SONRISA:
    .db 0b00111100,0b01000010,0b10100101,0b10000001
    .db 0b10100101,0b10011001,0b01000010,0b00111100

GUINO:
    .db 0b00111100,0b01000010,0b10101101,0b10000001
    .db 0b10100101,0b10011001,0b01000010,0b00111100

CORAZON:
    .db 0b01100110,0b11111111,0b11111111,0b11111111
    .db 0b01111110,0b00111100,0b00011000,0b00000000

CARA3:
    .db 0b00000000,0b01100110,0b01100110,0b00000000
    .db 0b10011001,0b10011001,0b10011001,0b01111110

ASTERISCO:
    .db 0b10010010,0b01010100,0b00111000,0b11111110
    .db 0b00111000,0b01010100,0b10010010,0b00000000

XD:
    .db 0b00010001,0b00001010,0b00000100,0b01101010
    .db 0b10110001,0b10100000,0b10100000,0b01100000
